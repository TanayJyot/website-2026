{
  "functions": {
    "api/*.js": {
      "includeFiles": "{private/writings/*.md,private/id-salt.txt,src/content/writings/*.md}"
    }
  },
  "rewrites": [
    {
      "source": "/node/Opportunities",
      "destination": "/opportunities.html"
    },
    {
      "source": "/node/opportunities",
      "destination": "/opportunities.html"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
